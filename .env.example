POSTGRES_PASSWORD=choose-a-strong-password
DATABASE_URL=postgres://app:choose-a-strong-password@postgres:5432/order_management?sslmode=disable
JWT_SECRET=choose-a-random-secret-with-at-least-32-characters
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:29092
AUTH_HTTP_PORT=8081
PRODUCT_HTTP_PORT=8082
ORDER_HTTP_PORT=8083
NOTIFICATION_HTTP_PORT=8084
REDIS_CACHE_TTL=5m
REDIS_DB=0
KAFKA_PRODUCT_TOPIC=product.events
KAFKA_ORDER_TOPIC=order.created
KAFKA_NOTIFICATION_GROUP=notification-service
ENVIRONMENT=development

# SMTP used by the notification service. Copy this file to .env.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# SMTP_PASSWORD must be a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=Order Management <your-email@gmail.com>

POSTGRES_PASSWORD=choose-a-strong-password
JWT_SECRET=choose-a-random-secret-with-at-least-32-characters

# SMTP used by the notification service. Copy this file to .env.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# SMTP_PASSWORD must be a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=Order Management <your-email@gmail.com>
